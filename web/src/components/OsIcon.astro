---
import type { OsKey } from "../lib/data";

interface Props {
  os: OsKey;
  class?: string;
}
const { os, class: className = "size-3" } = Astro.props;
---

{
  os === "windows" ? (
    <svg viewBox="0 0 16 16" class={className} fill="currentColor" aria-hidden="true"><path d="M0 2.3 6.5 1.4v6.2H0Zm7.3-1L16 0v7.6H7.3ZM0 8.4h6.5v6.2L0 13.7Zm7.3 0H16V16l-8.7-1.2Z" /></svg>
  ) : os === "linux" ? (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3c-2.2 0-3.5 1.8-3.5 4.2 0 1.6-.6 2.7-1.6 4.1C5.7 13 5 14.6 5 16.3 5 19 7.6 21 12 21s7-2 7-4.7c0-1.7-.7-3.3-1.9-5-1-1.4-1.6-2.5-1.6-4.1C15.5 4.8 14.2 3 12 3Z" /><path d="M10 8h.01M14 8h.01" stroke-width="2.5" stroke-linecap="round" /></svg>
  ) : os === "macos" ? (
    <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.9c-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6s1.8-.8 3.3-.8 2 .8 3.3.8 2.2-1.3 3-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.2ZM14 5.3c.7-.8 1.2-2 1-3.2-1 0-2.2.7-3 1.5-.6.7-1.2 1.9-1 3.1 1.1.1 2.3-.6 3-1.4Z" /></svg>
  ) : (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
  )
}
