---
import OsIcon from "./OsIcon.astro";
import { pythonLabel, summarize, url, type Package } from "../lib/data";

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
const latest = pkg.versions[0]!;
const s = summarize(latest);
const py = s.pythons.length > 1 ? `${pythonLabel(s.pythons[0])} – ${pythonLabel(s.pythons.at(-1))}` : pythonLabel(s.pythons[0]);
const osKeys = [...new Set(s.platforms.map((p) => p.os))].join(" ");
---

<a
  href={url(`packages/${pkg.name}/`)}
  data-pkg={pkg.name}
  data-os={osKeys}
  class="surface group relative flex flex-col gap-4 p-5 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/5 dark:hover:border-brand-400/40"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-[15px] font-semibold tracking-tight" style={`view-transition-name: pkg-${pkg.name}`}>{pkg.name}</h3>
    <span class="rounded-full bg-brand-50 px-2.5 py-0.5 font-mono text-xs font-medium text-brand-700 ring-1 ring-brand-100 dark:bg-brand-500/10 dark:text-brand-300 dark:ring-brand-500/20">
      v{pkg.latest}
    </span>
  </div>

  <div class="flex flex-wrap gap-1.5">
    {s.platforms.map((p) => (
      <span class="chip" title={p.detail}><OsIcon os={p.os} />{p.label}</span>
    ))}
  </div>

  <dl class="mt-auto grid grid-cols-3 gap-2 border-t border-zinc-100 pt-3 text-xs dark:border-white/5">
    <div>
      <dt class="text-zinc-500">Python</dt>
      <dd class="mt-0.5 font-medium">{py}</dd>
    </div>
    <div>
      <dt class="text-zinc-500">Versions</dt>
      <dd class="mt-0.5 font-medium">{pkg.versions.length}</dd>
    </div>
    <div>
      <dt class="text-zinc-500">Updated</dt>
      <dd class="mt-0.5 font-medium">
        {s.updated ? <time datetime={s.updated} data-relative>{s.updated.slice(0, 10)}</time> : "—"}
      </dd>
    </div>
  </dl>

  <svg viewBox="0 0 24 24" class="absolute bottom-5 right-5 size-4 -translate-x-1 text-brand-500 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" />
  </svg>
</a>
