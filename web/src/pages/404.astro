---
import Base from "../layouts/Base.astro";
import { url } from "../lib/data";
---

<Base title="Not found">
  <section class="py-32 text-center">
    <p class="font-mono text-sm text-brand-500">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Nothing here</h1>
    <p class="mt-3 text-zinc-500">The page or package you're looking for doesn't exist.</p>
    <a href={url()} class="mt-8 inline-flex rounded-xl bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">Browse packages</a>
  </section>
</Base>
