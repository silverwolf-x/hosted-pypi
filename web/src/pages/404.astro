---
// GitHub Pages serves this single 404.html for every missing path (including
// /en/...), so it is rendered in the default locale with an English fallback line.
import Base from "../layouts/Base.astro";
import { DEFAULT_LOCALE, localeUrl, useTranslations } from "../i18n";

const t = useTranslations(DEFAULT_LOCALE);
const en = useTranslations("en");
---

<Base title={t.notFound.title} localized={false}>
  <section class="py-32 text-center">
    <p class="font-mono text-sm text-brand-500">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{t.notFound.heading}</h1>
    <p class="mt-3 text-zinc-500">{t.notFound.body}</p>
    <p class="mt-1 text-sm text-zinc-400" lang="en">{en.notFound.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={localeUrl(DEFAULT_LOCALE)} class="inline-flex rounded-xl bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">{t.notFound.back}</a>
      <a href={localeUrl("en")} lang="en" class="inline-flex rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-medium hover:border-zinc-300 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20">{en.notFound.back}</a>
    </div>
  </section>
</Base>
