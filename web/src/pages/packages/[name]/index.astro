---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import PackageView from "../../../components/PackageView.astro";
import { loadIndex, type Package } from "../../../lib/data";

export const getStaticPaths = (() =>
  loadIndex().packages.map((pkg) => ({ params: { name: pkg.name }, props: { pkg } }))) satisfies GetStaticPaths;

const { pkg } = Astro.props as { pkg: Package };
---

<Base title={`${pkg.name} ${pkg.latest} · wheels`} description={`Prebuilt ${pkg.name} ${pkg.latest} wheels.`}>
  <PackageView pkg={pkg} version={pkg.versions[0]!} />
</Base>
